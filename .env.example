# Public site URL used by next-sitemap
SITE_URL=https://www.thomasmoserdev.com

# Upstash Redis — post view counters and page-view analytics (server-only)
NEXT_UPSTASH_REDIS_URL=
NEXT_UPSTASH_REDIS_TOKEN=

# Spotify Web API — activity widgets (refresh token of the site owner's account)
NEXT_SPOTIFY_CLIENT_ID=
NEXT_SPOTIFY_CLIENT_SECRET=
NEXT_SPOTIFY_REFRESH_TOKEN=

# Steam Web API — activity widgets
NEXT_STEAM_API_KEY=
NEXT_STEAM_ID=

# Public (exposed to the browser)
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID=
NEXT_PUBLIC_COMMENT_REPOID=
NEXT_PUBLIC_COMMENT_CATEGORYID=
