# Upstash Redis — post view counters and page-view analytics (server-only). Counters are written only in
# production; REDIS_ALLOW_WRITES=1 lets a local run write (never against the shared production database).
NEXT_UPSTASH_REDIS_URL=
NEXT_UPSTASH_REDIS_TOKEN=

# Deezer API — activity widgets. Site owner's access token with the
# `offline_access` (never expires) and `listening_history` permissions.
DEEZER_TOKEN=

# Steam Web API — activity widgets
NEXT_STEAM_API_KEY=
NEXT_STEAM_ID=

# Public (exposed to the browser): Giscus comments
NEXT_PUBLIC_COMMENT_REPOID=
NEXT_PUBLIC_COMMENT_CATEGORYID=
